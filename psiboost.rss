// Tools > Test the speed: at 115200 only or 230400 only, as the line is
// now (nothing changed), or both, back to back (the modem told each speed);
// on one route against one server
RESOURCE DIALOG r_sp_test_dialog
	{
	title="Test the speed";
	flags=EEikDialogFlagWait|EEikDialogFlagButtonsRight;
	buttons=R_EIK_BUTTONS_CANCEL_OK;
	items=
		{
		DLG_LINE { type=EEikCtChoiceList; prompt="Speed"; id=ESpDlgTestSpeed;
			control=CHOICELIST { array_id=r_sp_speed_array; }; },
		DLG_LINE { type=EEikCtLabel; id=ESpDlgTestNote; control=LABEL { standard_font=EEikLabelFontAnnotation;
			reserve_length=70; txt="As the line is now: 230,400 bps always must be off"; }; },
		DLG_LINE { type=EEikCtChoiceList; prompt="Route"; id=ESpDlgTestRoute;
			control=CHOICELIST { array_id=r_sp_route_array; }; },
		DLG_LINE { type=EEikCtChoiceList; prompt="Length"; id=ESpDlgTestLength;
			control=CHOICELIST { array_id=r_sp_length_array; }; },
		DLG_LINE { type=EEikCtChoiceList; prompt="Server"; id=ESpDlgTestServer;
			control=CHOICELIST { array_id=r_sp_server_array; }; },
		DLG_LINE { type=EEikCtEdwin; prompt="Server name or address"; id=ESpDlgTestHost;
			control=EDWIN { width=16; maxlength=50; }; },
		DLG_LINE { type=EEikCtNumberEditor; prompt="Base port"; id=ESpDlgTestPort;
			control=NUMBER_EDITOR { min=0; max=65000; }; },
		DLG_LINE { type=EEikCtLabel; id=ESpDlgTestPorts; control=LABEL { standard_font=EEikLabelFontAnnotation;
			reserve_length=70; txt="Echo 7107 and chargen 7119, as server/stdsvc.py with base port 7100"; }; }
		};
	}

RESOURCE ARRAY r_sp_speed_array
	{
	items={ LBUF { txt="115,200 bps"; }, LBUF { txt="230,400 bps"; }, LBUF { txt="Both (the modem changes speed)"; } };
	}

// What is on the other end of the serial cable: a modem (told the speed by
// AT commands), or a computer or other device whose speed is set by hand
// (the hook only, no AT). Speed > The other end...
RESOURCE DIALOG r_sp_end_dialog
	{
	title="The other end";
	flags=EEikDialogFlagWait;
	buttons=R_EIK_BUTTONS_CANCEL_OK;
	items=
		{
		DLG_LINE { type=EEikCtLabel; control=LABEL { txt="What is on the other end of the Psion's serial cable?"; }; },
		DLG_LINE { type=EEikCtChoiceList; prompt="The other end"; id=ESpDlgOtherEnd;
			control=CHOICELIST { array_id=r_sp_end_array; }; },
		DLG_LINE { type=EEikCtLabel; control=LABEL { standard_font=EEikLabelFontAnnotation;
			txt="A modem answers AT commands: the PsiConnect Wi-Fi modem, a dial-up modem, a phone"; }; },
		DLG_LINE { type=EEikCtLabel; control=LABEL { standard_font=EEikLabelFontAnnotation;
			txt="A computer does not: a serial cable or a USB serial adapter, running pppd or similar"; }; },
		DLG_LINE { type=EEikCtLabel; id=ESpDlgEndNext; control=LABEL { reserve_length=50; txt="-"; }; },
		DLG_LINE { type=EEikCtLabel; id=ESpDlgEndHow; control=LABEL { standard_font=EEikLabelFontAnnotation;
			reserve_length=80; txt="-"; }; },
		DLG_LINE { type=EEikCtLabel; id=ESpDlgEndLater; control=LABEL { standard_font=EEikLabelFontAnnotation;
			reserve_length=60; txt="You can change this later in Speed > The other end"; }; }
		};
	}

