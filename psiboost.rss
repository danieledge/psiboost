	menubar=r_sp_menubar;
	hotkeys=r_sp_hotkeys;
	toolbar=r_sp_toolbar;
	}

// The toolbar: the name, four buttons (Always stays pressed in while 230400
// always is on), the clock
RESOURCE TOOLBAR r_sp_toolbar
	{
	breadth=KEikStdToolBarWidth;
	controls=
		{
		TBAR_CTRL
			{
			type=EEikCtLabel;
			flags=EEikToolBarCtrlHasSetMinLength;
			length=KEikStdFileNameLabelHeight;
			control=LABEL { txt="PsiBoost"; horiz_align=EEikLabelAlignHCenter; vert_align=EEikLabelAlignVCenter; };
			},
		TBAR_BUTTON { id=ESpCmdFast; layout=EEikCmdButTextRightPictureLeft|EEikCmdButDenseFont|EEikCmdButExcessToText; txt="Always"; flags=EEikToolBarCtrlHasSetMinLength; length=KEikStdToolBarButtonHeight; },
		TBAR_BUTTON { id=ESpCmdFree; layout=EEikCmdButTextRightPictureLeft|EEikCmdButDenseFont|EEikCmdButExcessToText; txt="Free"; flags=EEikToolBarCtrlHasSetMinLength; length=KEikStdToolBarButtonHeight; },
		TBAR_BUTTON { id=ESpCmdTest; layout=EEikCmdButTextRightPictureLeft|EEikCmdButDenseFont|EEikCmdButExcessToText; txt="Test"; flags=EEikToolBarCtrlHasSetMinLength; length=KEikStdToolBarButtonHeight; },
		TBAR_BUTTON { id=ESpCmdResults; layout=EEikCmdButTextRightPictureLeft|EEikCmdButDenseFont|EEikCmdButExcessToText; txt="Results"; flags=EEikToolBarCtrlHasSetMinLength; length=KEikStdToolBarButtonHeight; },
		TBAR_CTRL
			{
			type=EEikCtSpacer;
			flags=EEikToolBarCtrlHasSetMinLength|EEikToolBarCtrlIsStretchable;
			length=0;
			control=SPACER;
			},
		TBAR_CTRL
			{
			type=EEikCtClock;
			control=CLOCK { digitalresourceid=R_EIK_DIGITAL_CLOCK; analogresourceid=R_EIK_ANALOG_CLOCK; };
			},
		TBAR_CTRL
			{
			type=EEikCtSpacer;
			flags=EEikToolBarCtrlHasSetMinLength;
			length=KEikStdGapBelowClock;
			control=SPACER;
			}
		};
	}

// Shortcuts: EIKON's standard letters (Ctrl+E close, Ctrl+T toolbar,
// Shift+Ctrl+H help, Shift+Ctrl+A about), and free shifted letters for
// PsiBoost's own: B 230400 always (boost), R release (free) the serial port,
// D the test, X stop it, L the last results
RESOURCE HOTKEYS r_sp_hotkeys
	{
	control=
		{
		HOTKEY { command=EEikCmdExit; key='e'; },
		HOTKEY { command=ESpCmdToolbar; key='t'; }
		};
	shift_control=
		{
		HOTKEY { command=ESpCmdFast; key='b'; },
		HOTKEY { command=ESpCmdFree; key='r'; },
		HOTKEY { command=ESpCmdTest; key='d'; },
		HOTKEY { command=ESpCmdTestStop; key='x'; },
		HOTKEY { command=ESpCmdResults; key='l'; },
		HOTKEY { command=ESpCmdHelp; key='h'; },
		HOTKEY { command=ESpCmdAbout; key='a'; }
		};
	}

