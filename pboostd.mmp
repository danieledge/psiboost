// pboostd.mmp - PsiBoost's helper
TARGET          pboostd.exe
TARGETTYPE      exe
UID             0 0x01000A95
PROJECT         ptproj
SUBPROJECT      psiboost
SOURCE          pboostd.cpp sptest.c
USERINCLUDE     . \ptproj\psiboostcore
SYSTEMINCLUDE   \epoc32\include
LIBRARY         euser.lib efsrv.lib c32.lib nifman.lib esock.lib insock.lib
EPOCSTACKSIZE   0x5000
